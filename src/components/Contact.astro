---
    import Form from '../components/Form.astro';
    import HorizontalScroll from '../components/HorizontalScroll.astro';
    import ScrollBar from '../components/ScrollBar.astro';
    import Banner from '../components/Banner.astro';
---
<script>
    import gsap from "gsap";
    import ScrollTrigger from "gsap/ScrollTrigger";
    import SplitText from "gsap/SplitText";

    gsap.registerPlugin(ScrollTrigger, SplitText);

    let mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {

        const split = new SplitText("p", { type: "words" });

        gsap.from(split.words,{
            opacity: 0.2,
            stagger: {each: 0.4},
            scrollTrigger: {
                trigger: "p",
                start: "top 30%",
                end: "top 5%",
                scrub: true,
            },
        }
        );
    });
</script>

<ScrollBar />

<section>
    <h1>Get in touch with <em>us.</em></h1>
    <p>Got a vision for your business?</p>
    <p>Let's build it together.</p>
</section>

<HorizontalScroll text="Don't be shy. Let's talk." />

<div class="form">
    <Form variant="page" />
    <img src="/images/contact.png" alt="" width="400" height="520">
</div>

<Banner />
<style>
    .form {
        display: flex;
        flex-direction: column;
        padding-bottom: 3em;
        @media (min-width: 768px) {
            flex-direction: row;
            justify-content: center;
            align-items: center;
            column-gap: 5em;
        }
    }

    section {
        margin-top: 5em;
        padding: 2em 1em 2em 3em;
        @media (min-width: 768px) {
            margin-top: 19em;
            margin-bottom: 9em;
            padding-left: 4em;
        }
    }

    section p:nth-of-type(1) {
        margin-top: 2em;
    }

    h1 {
        font-family: var(--font-inter-bold);
        font-size: clamp(var(--font-size-l), 10svw, var(--font-size-xxxl));
        font-weight: 700;
        line-height: 1.05;
        color: var(--primary-bordeaux);
    }

    em {
        font-family: var(--font-anastasia-regular);
        font-weight: 400;
        color: var(--neutral-browngreen);
    }

    p {
        line-height: 1.5;
        font-weight: 400;
        font-family: var(--font-inter-regular);
        font-size: clamp(var(--font-size-s), 2vw, var(--font-size-xl));
        color: var(--primary-bordeaux);
    }

    img {
        max-width: 100vw;
    }

</style>

