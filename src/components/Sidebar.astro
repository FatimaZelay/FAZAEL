---
interface Props {
  items: {
    id: string;
    label: string;
  }[];
}

const { items = [] } = Astro.props;

const links = items.map((item) => ({
  href: "#" + item.id,
  label: item.label,
  number: item.label.split('.')[0],
  className: "sidebar-item",
}));
---

<aside class="sidebar">
  {links.map((link) => (
    <a href={link.href} class={link.className}>
      <span class="label">{link.label}</span>
      <span class="number">{link.number}</span>
    </a>
  ))}
</aside>

<style>
  body.menu-open .sidebar {
    display: none;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 36px;
    min-width: 36px;
    flex-shrink: 0;
    position: sticky;
    top: 50vh;
    transform: translateY(-50%);
    align-self: flex-start;

    @media (min-width: 768px) {
      width: 180px;
      min-width: 180px;
      gap: 6px;
      margin-top: 250px;
      padding-top: 8px;
    }
  }


  .sidebar-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--neutral-white);
    font-size: 0.75rem;
    font-family: var(--font-inter-regular);
    color: var(--primary-bordeaux);
    text-decoration: none;
    transition: background 0.15s;

    &:hover {
      background: var(--primary-bone);
    }

    &.active {
      background: var(--primary-bordeaux);
      color: var(--neutral-white);
    }

    @media (min-width: 768px) {
      width: auto;
      height: auto;
      border-radius: var(--border-radius);
      padding: 10px 16px;
      justify-content: flex-start;
      font-size: var(--font-size-base);
    }
  }

  .label {
    display: none;

    @media (min-width: 768px) {
      display: inline;
    }
  }

  .number {
    display: flex;
    font-size: 0.75rem;
    font-family: var(--font-inter-regular);

    @media (min-width: 768px) {
      display: none;
    }
  }
</style>