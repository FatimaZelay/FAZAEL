<section class="hero">
    <h1 id="hero-title">
        We create for
        <em>female</em>
        entrepreneurs. You
        <em>visualize</em>
        We design & build your <em>website</em>
    </h1>
</section>

<script>
    document.documentElement.classList.add("js");

    const title = document.getElementById("hero-title");
    if (title) {
        const nodes = Array.from(title.childNodes);
        const fragment = document.createDocumentFragment();

        nodes.forEach((node, i) => {
            const span = document.createElement(
                node.nodeName === "EM" ? "em" : "span",
            );
            span.textContent = node.textContent;
            span.style.display = "inline-block";
            span.style.margin = "0 0.10em";
            span.style.animation = `fadeUp 0.9s cubic-bezier(0.22, 0.68, 0, 1.1) ${4 + i * 0.1}s both`;
            fragment.appendChild(span);
        });

        title.innerHTML = "";
        title.appendChild(fragment);
    }
</script>

<style>
    .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;

        @media (min-width: 768px) {
            padding-top: 10em;
        }
    }

    .hero h1 {
        font-family: var(--font-inter-bold);
        font-weight: 700;
        font-size: clamp(2rem, 8vw, 3rem);
        line-height: 1.05;
        margin: 0 0.1em;
        letter-spacing: -0.05em;
        color: var(--primary-bordeaux);
        max-width: 25ch;
        animation: fadeUp 0.9s cubic-bezier(0.22, 0.68, 0, 1.1) 0.2s both; /* Here's where the CSS fallback starts, whole h1 fades up as one block when JS is off */

        @media (min-width: 769px) {
            font-size: clamp(2.2rem, 4.5vw, 4.5rem);
        }
    }

        font-weight: 400;
        font-family: var(--font-inter-regular);
        color: var(--primary-bordeaux);
        max-width: 20em;
    }

    .script {
        font-family: var(--font-anastasia-italic);
        font-size: 3em;
    }
</style>
