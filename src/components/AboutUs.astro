<script>
    const thumbs = document.querySelectorAll<HTMLElement>(".thumb");

    thumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
            const name = thumb.dataset.person;
            if (!name) return;

            thumbs.forEach((t) => t.classList.remove("active"));
            thumb.classList.add("active");

            document
                .querySelectorAll<HTMLElement>(".featured")
                .forEach((img) => {
                    if (img.id === `img-${name}`) {
                        img.style.opacity = "0";
                        img.classList.add("visible");
                        requestAnimationFrame(() => {
                            img.style.transition = "opacity 0.45s ease";
                            img.style.opacity = "1";
                        });
                    } else {
                        img.style.opacity = "0";
                        setTimeout(() => img.classList.remove("visible"), 440);
                    }
                });

            document
                .querySelectorAll<HTMLElement>(".person-panel")
                .forEach((panel) => {
                    panel.classList.toggle(
                        "active",
                        panel.id === `bio-${name}`,
                    );
                });
        });
    });

    import gsap from "gsap";
    import ScrollTrigger from "gsap/ScrollTrigger";
    import SplitText from "gsap/SplitText";

    gsap.registerPlugin(ScrollTrigger, SplitText);

    let mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {

        const split = new SplitText(".intro-text", { type: "words" });

        gsap.from(split.words,{
            opacity: 0.2,
            stagger: {each: 0.4},
            scrollTrigger: {
                trigger: ".intro-text",
                start: "top 30%", /*You can play with the percentage for the mobile version*/
                end: "top 2%",
                scrub: true,
            },
        }
        );
    });
</script>
</script>

