<section class="hero">
    <div class="hero-headline">
        <div>
            We're two <em>female</em><br />
            developers, we build and create<br />
        </div>
    </div>

    <div class="hero-bottom">
        <p class="hero-desc">
            Fazael is a creative digital agency focused on helping female
            entrepreneurs bring their vision to life. We design websites, and
            digital experiences that feel elegant, intentional, and built to
            grow with purpose
        </p>
    </div>
</section>

<section class="team-section">
    <h1 class="team-headline">The two of <em>us.</em></h1>

    <div class="team-grid">
        <div class="thumb-strip">
            <div class="thumb active" data-person="Fatima">
                <img src="/images/Fatima.png" alt="Fatima Z" />
            </div>
            <div class="thumb" data-person="Karima">
                <img src="/images/Karima.png" alt="Karima M" />
            </div>
        </div>

        <div class="featured-img">
            <img
                id="img-Fatima"
                src="/images/Fatima.png"
                alt="Fatima Z"
                class="featured visible"
            />
            <img
                id="img-Karima"
                src="/images/Karima.png"
                alt="Karima M"
                class="featured"
            />
        </div>

        <div class="bio-panel">
            <div class="person-panel active" id="bio-Fatima">
                <div class="bio-role">
                    Co-Founder &middot; Frontend Developer &amp; UI/UX Designer
                </div>
                <h3 class="bio-name">Fatima Z</h3>
                <p class="bio-text">
                    Fatima has always been passionate about creativity. At just
                    18 years old, she started her own business to turn ideas
                    into meaningful designs. Today, she helps female
                    entrepreneurs bring their vision to life through branding
                    and modern digital experiences.
                </p>
                <div class="bio-stats">
                    <div>
                        <div class="stat-label">Based in</div>
                        <div class="stat-value">Amsterdam</div>
                    </div>
                    <div>
                        <div class="stat-label">Building since</div>
                        <div class="stat-value">2024</div>
                    </div>
                </div>
            </div>

            <div class="person-panel" id="bio-Karima">
                <div class="bio-role">
                    Co-Founder &middot; Frontend Developer &amp; UI/UX Designer
                </div>
                <h3 class="bio-name">Karima M</h3>
                <p class="bio-text">
                    I'm Karima, a frontend designer and developer based in
                    Amsterdam. Specializing in building modern and user-friendly
                    websites. With a strong focus on detail and accessibility I
                    transform ideas into powerful digital experiences. As a
                    master's degree student in International Technology law and
                    Internet law & IE I also build websites in compliance with
                    current European and International legislation.
                </p>
                <div class="bio-stats">
                    <div>
                        <div class="stat-label">Based in</div>
                        <div class="stat-value">Amsterdam</div>
                    </div>
                    <div>
                        <div class="stat-label">Building since</div>
                        <div class="stat-value">2024</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="closing-quote">
    <p>
        "It should be easy for woman to translate their creativity into a
        reality"
    </p>
</div>

<script>
    const thumbs = document.querySelectorAll<HTMLElement>(".thumb");

    thumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
            const name = thumb.dataset.person;
            if (!name) return;

            thumbs.forEach((t) => t.classList.remove("active"));
            thumb.classList.add("active");

            document
                .querySelectorAll<HTMLElement>(".featured")
                .forEach((img) => {
                    if (img.id === `img-${name}`) {
                        img.style.opacity = "0";
                        img.classList.add("visible");
                        requestAnimationFrame(() => {
                            img.style.transition = "opacity 0.45s ease";
                            img.style.opacity = "1";
                        });
                    } else {
                        img.style.opacity = "0";
                        setTimeout(() => img.classList.remove("visible"), 440);
                    }
                });

            document
                .querySelectorAll<HTMLElement>(".person-panel")
                .forEach((panel) => {
                    panel.classList.toggle(
                        "active",
                        panel.id === `bio-${name}`,
                    );
                });
        });
    });
</script>
