<script>
    import gsap from "gsap";
    import ScrollTrigger from "gsap/ScrollTrigger";
    import SplitText from "gsap/SplitText";

    gsap.registerPlugin(ScrollTrigger, SplitText);

    const splitMission = new SplitText(".mission", { type: "words" });

    gsap.from(splitMission.words,{
        opacity: 0.2,
        stagger: {each: 0.4},
        scrollTrigger: {
        trigger: ".mission",
        start: "top 60%",
        end: "top 5%",
        scrub: true,
        },
    }
    );

    const splitContact = new SplitText(".contact-text", { type: "words" });

    gsap.from(splitContact.words,{
        opacity: 0.2,
        stagger: {each: 0.4},
        scrollTrigger: {
        trigger: ".contact-text",
        start: "top 50%",
        end: "top 5%",
        scrub: true,
        },
    }
    );
</script>

<section>
    <p class="mission">We believe that building an vision shouldn’t feel overwhelming or out of reach. Instead, it should be an empowering step in growing a business.</p>
    <p class="contact-text">That’s why we create websites that support every woman with a vision in building a strong online presence. Let’s turn your vision into reality. Connect with us through the contact form.</p>
</section>
